{
  "name": "ls-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "GTA V asset portfolio — vehicles, properties, businesses, aircraft, boats, and more",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx scripts/fetch-sources.ts",
    "build:vehicles": "tsx scripts/build-vehicles.ts",
    "build:properties": "tsx scripts/build-properties.ts",
    "validate": "tsx scripts/validate-seed.ts",
    "seed:all": "npm run fetch && npm run build:vehicles && npm run build:properties && npm run validate",
    "db:import": "tsx --env-file=.env.local scripts/import-seed.ts",
    "images:publish": "node scripts/publish-images.mjs",
    "images:fetch-missing": "tsx --env-file=.env.local scripts/fetch-missing-images.ts",
    "vehicles:prune-variants": "tsx --env-file=.env.local scripts/prune-redundant-variants.ts",
    "mfr:fix-acronyms": "tsx --env-file=.env.local scripts/fix-manufacturer-display.ts",
    "availability:apply": "tsx --env-file=.env.local scripts/apply-availability.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "supabase": "^2.91.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
