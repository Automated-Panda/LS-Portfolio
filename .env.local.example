# Copy this file to .env.local and fill in real values from your
# Supabase project settings (Project Settings → API).
# .env.local is gitignored — never commit real keys.

# Public-facing (safe in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (NEVER expose to the client — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email allowed into the /admin catalog editor. MUST match the email you sign
# into the app with. Server-only.
ADMIN_EMAIL=you@example.com

# Anthropic API key for the /organize AI features (Piece 2).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Stripe — secret key (sk_test_… locally, sk_live_… in prod) for checkout/webhook/portal.
STRIPE_SECRET_KEY=...
# Stripe webhook signing secret. Locally: from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# In prod: from the Stripe dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=...
